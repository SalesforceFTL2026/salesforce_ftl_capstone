# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mapresponse"

# AI APIs
#
# All AI-text features (chat, the voice agent, voice extraction, priority
# explanation, and the resource/task advisors) share one provider chain in
# services/ai/chatbot.js:
#   Gemini (rotated across models) -> OpenRouter free -> OpenAI (opt-in, paid)
# Cohere powers request-similarity embeddings for prioritization.

# OpenAI — Whisper voice transcription (the one-shot dictation intake) AND the
# final PAID fallback in the LLM text chain. The text fallback is off unless
# ALLOW_PAID_FALLBACK=true, so this key normally only spends on Whisper.
OPENAI_API_KEY="sk-your-key-here"

# Cohere — embeddings for request similarity / priority scoring.
COHERE_API_KEY="your-cohere-key-here"

# OpenRouter — primary provider for the Mappie chat assistant and all LLM text
# features (services/ai/chatbot.js). Each teammate makes their OWN free key
# (no shared key, no credits needed):
#   1. Sign up at https://openrouter.ai
#   2. Create a key at https://openrouter.ai/keys
#   3. Paste it below in your local .env (never commit the real value)
OPENROUTER_API_KEY="sk-or-your-key-here"

# Google Gemini — PRIMARY provider for the LLM text chain. Free tier meters
# requests per MODEL (~20/day and 5-10/min each), not per project, so chatbot.js
# rotates across several models to multiply the free budget. Check your own
# current limits at https://aistudio.google.com/rate-limit
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY="your-google-ai-studio-key-here"

# Optional — override the rotation order (comma-separated, weakest first). Only
# needed when Google retires a model id or you want to reserve one for a
# specific feature. Retired ids fall through harmlessly.
# GEMINI_MODEL_CHAIN="gemini-2.5-flash-lite,gemini-2.5-flash,gemini-flash-latest"

# Optional — allow the LLM chain to fall through to the PAID OpenAI model when
# every free tier is exhausted. Off by default so no code path can spend credits
# unattended; the affected features surface a "try again in a moment" message
# instead. Set to "true" to buy availability (e.g. before a live demo).
# ALLOW_PAID_FALLBACK="false"

# Anthropic (Claude) — LOCAL TESTING ONLY. When set AND NODE_ENV is not
# "production", it becomes the preferred provider in the LLM text chain. It is
# disabled entirely in production (see services/ai/clients.js), so it is never
# set on the deployed server. Optional — leave blank to use OpenRouter locally.
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Server
PORT=3000
NODE_ENV="development"

# Auth
# Secret used to sign login tokens (JWTs). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value — keep it only in .env
JWT_SECRET_KEY="your-long-random-secret-here"
