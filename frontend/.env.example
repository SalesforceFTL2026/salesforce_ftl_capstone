VITE_API_URL=http://localhost:3000

# Voice agent speech-to-text engine. Defaults to Deepgram streaming STT (higher
# accuracy on accents/noise, paid), with automatic fallback to the browser's
# free, on-device Web Speech API whenever Deepgram can't run — including when the
# backend has no DEEPGRAM_API_KEY set. Set to "web-speech" to force the free
# engine and never use Deepgram (e.g. to guarantee zero cost).
# VITE_STT_PROVIDER=web-speech

# Optional — override the Deepgram model (defaults to nova-2).
# VITE_DEEPGRAM_MODEL=nova-2

# Google Sign-In — the "Sign in with Google" button uses this to know which
# Google app to authenticate against. Same value as the backend's
# GOOGLE_CLIENT_ID. Public (safe to expose in the browser); the "VITE_" prefix
# is required for Vite to expose it to frontend code.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
