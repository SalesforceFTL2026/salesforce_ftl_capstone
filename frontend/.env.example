VITE_API_URL=http://localhost:3000

# Google Sign-In — the "Sign in with Google" button uses this to know which
# Google app to authenticate against. Same value as the backend's
# GOOGLE_CLIENT_ID. Public (safe to expose in the browser); the "VITE_" prefix
# is required for Vite to expose it to frontend code.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
